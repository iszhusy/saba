{
  "name": "saba",
  "version": "1.0.0",
  "description": "Side-Effect Assessment for Breast cancer patients with AI-powered feedback",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-env.mjs && vite",
    "setup:env": "node scripts/ensure-env.mjs",
    "dev:demo": "tsx watch src/demo.ts",
    "build": "tsc",
    "build:web": "vite build",
    "preview": "vite preview",
    "preview:demo": "tsx src/demo.ts",
    "test": "vitest run",
    "test:arch": "vitest run src/lib/architecture-invariants.test.ts src/lib/mode-protocol-remnants.test.ts",
    "harness": "tsx run-harness.ts",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "openai": "^6.37.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "@fission-ai/openspec": "^1.3.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^1.0.0"
  }
}
