# SABA - Side-Effect Assessment for Breast cancer patients with AI-powered feedback
# 环境变量配置

# ============================================================
# LLM Provider 选择
# ============================================================
# 可选: anthropic / dashscope / minimax
LLM_PROVIDER=anthropic

# ============================================================
# Anthropic Claude API 配置（可选）
# ============================================================
# 获取方式: https://console.anthropic.com/settings/keys
# 推荐模型: claude-sonnet-4-20250514（性价比高）
# 其他可选: claude-opus-4-20250514（更聪明但更贵）
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1024

# ============================================================
# DashScope / Qwen 配置（可选）
# ============================================================
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen3.6-plus

# ============================================================
# MiniMax 配置（可选）
# ============================================================
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M1

# ============================================================
# 应用配置
# ============================================================
APP_ENV=development
LOG_LEVEL=info

# ============================================================
# RAG 配置
# ============================================================
# 是否启用 RAG 知识库检索
RAG_ENABLED=true

# ============================================================
# 本地开发存储（Vite dev-api）
# ============================================================
# 默认使用 wrangler 本地 D1（.wrangler/state，与 Workers 同 schema）
# 设为 memory 则回退进程内 Map（不落盘）
# SABA_DEV_STORAGE=d1
# SABA_DEV_STORAGE=memory

# 首次或 schema 变更后：npm run d1:local:init

# ============================================================
# Cloudflare Workers 部署说明
# ============================================================
# 在 Cloudflare Workers 中部署时，使用 wrangler secret 设置敏感配置:
#
#   npx wrangler secret put ANTHROPIC_API_KEY
#
# 非敏感配置可以在 wrangler.toml 的 vars 中设置:
#
#   vars = { RAG_ENABLED = "true", APP_ENV = "production" }
